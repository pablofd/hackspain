HOST=127.0.0.1
PORT=7860
MAX_CONCURRENT_CALLS=20
# Explicit selection only; no automatic fallback or model switching.
VOICE_CONNECTOR=realtime

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-realtime-1.5
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_VOICE=coral
AZURE_OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Separate experimental profile. The Realtime deployment and protocol stay unchanged.
AZURE_OPENAI_LIVE_DEPLOYMENT=gpt-live-1
AZURE_OPENAI_LIVE_BACKEND_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_LIVE_VOICE=coral

# DefaultAzureCredential uses the VM's managed identity; no Azure API key needed.
# Set AZURE_CLIENT_ID only when choosing a user-assigned managed identity.
# Alternatively, these AZURE_OPENAI_* settings can come from .env.lang.
# AZURE_OPENAI_API_KEY=

PROSPER_API_BASE_URL=https://hackspain.getprosperapp.com
PROSPER_API_KEY=

# Generated by npm run configure. Set this as a Bearer header in Prosper.
VOICE_ENDPOINT_TOKEN=
# Optional bounded output gain for quiet telephony speech; 0 leaves mu-law bytes unchanged.
VOICE_OUTPUT_GAIN_DB=0
# Independent level for GPT-Live; do not assume both models have the same loudness.
VOICE_LIVE_OUTPUT_GAIN_DB=0

# Optional locally. Required to export traces to Azure / Foundry.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=hackspain-cachopo

# Private local transcripts/action records, never served by HTTP or sent to Azure Monitor.
CALL_RECORDING_ENABLED=true
CALL_RECORDING_RETENTION_DAYS=7
# Opt-in private stereo WAV. Unlike text logs, spoken secrets cannot be redacted.
CALL_AUDIO_RECORDING_ENABLED=false

# Optional alternative to the Cloudflare tunnel; used only by npm run tunnel:ngrok.
# Get the agent authtoken from your own ngrok account, not an Azure/Prosper key.
NGROK_AUTHTOKEN=
# Optional HTTPS URL assigned to your ngrok account; omit to use its default domain.
NGROK_URL=

# Independent read-only dashboard. Can also be set in private .local/dashboard.env.
# Never reuse the voice endpoint token or an Azure/Prosper key.
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4321
# Optional exact Vercel frontend origin, HTTPS without trailing slash; never a wildcard.
# DASHBOARD_PUBLIC_ORIGIN=https://your-dashboard.vercel.app
# Vercel build only: public HTTPS origin of the persistent adapter on port 4321.
# DASHBOARD_BACKEND_ORIGIN=https://dashboard-backend.example.com
DASHBOARD_VOICE_URL=http://127.0.0.1:7860
DASHBOARD_RECORDS_DIR=.local/calls
DASHBOARD_HISTORY_DAYS=7
# On-demand, paid text estimates for the selected real call only; no voice-path effect.
DASHBOARD_SIGNALS_ENABLED=true
DASHBOARD_SIGNALS_DEPLOYMENT=gpt-5.4-mini
# Optional: read the voice configuration/records from another checkout, without copying secrets.
# DASHBOARD_ENV_DIR=/absolute/path/to/backend-checkout

# Read-only Azure Monitor queries use DefaultAzureCredential, NOT the OpenAI API key.
# Cognitive Services ARM resource ID, not the inference endpoint URL.
AZURE_MONITOR_RESOURCE_ID=
# Log Analytics workspace GUID for the linked Application Insights traces.
AZURE_MONITOR_WORKSPACE_ID=
# Optional external resource; the voice runtime does not use separate Azure Speech.
AZURE_SPEECH_RESOURCE_ID=
